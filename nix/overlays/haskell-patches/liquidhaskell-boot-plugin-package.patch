+                units = ue_units (hsc_unit_env hscEnv)
+                mhome_unit = hsc_home_unit_maybe hscEnv
+            query <- hscUnitIndexQuery hscEnv
+            findPluginModule fc fopts units query mhome_unit assumptionsModName
       case res of
